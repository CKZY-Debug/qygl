+                <div class="form-section">
+                    <h2>📝 添加用户</h2>
+                    <div class="form-row">
+                        <div class="form-group">
+                            <label for="name">姓名</label>
+                            <input type="text" id="name" placeholder="请输入姓名" required>
+                        </div>
+                        <div class="form-group">
+                            <label for="age">年龄</label>
+                            <input type="number" id="age" placeholder="请输入年龄" required>
+                        </div>
+                        <div class="form-group">
+                            <label for="email">邮箱</label>
+                            <input type="email" id="email" placeholder="请输入邮箱">
+                        </div>
+                        <button class="btn" id="btnSubmit" onclick="addUser()">添加</button>
+                    </div>
+                </div>
+
+                <div class="table-header">
+                    <h2>📋 用户列表</h2>
+                    <button class="btn btn-outline btn-sm" id="btnRefresh" onclick="loadUsers()">🔄 刷新</button>
+                </div>
+
+                <div id="loading" class="loading">
+                    <div class="spinner"></div>
+                    <div>加载中...</div>
+                </div>
+
+                <div class="table-wrapper" id="tableWrapper" style="display: none;">
+                    <table>
+                        <thead>
+                            <tr>
+                                <th>ID</th>
+                                <th>姓名</th>
+                                <th>年龄</th>
+                                <th>邮箱</th>
+                            </tr>
+                        </thead>
+                        <tbody id="userTableBody">
+                            <tr class="empty-row">
+                                <td colspan="4">暂无用户数据</td>
+                            </tr>
+                        </tbody>
+                    </table>
+                </div>
+            </div>
+        </div>
+
+        <!-- ==================== Tab 2: DeepSeek AI ==================== -->
+        <div class="tab-content" id="tab-ai">
+            <div class="content">
+                <!-- API Key 未配置提示 -->
+                <div class="api-key-warning" id="apiKeyWarning">
+                    ⚠️ DeepSeek API Key 未配置，请在 <code>application.properties</code> 中设置 <code>deepseek.api.key</code>。
+                    <a href="https://platform.deepseek.com/api_keys" target="_blank" style="color:#856404;font-weight:500;">去获取 Key</a>
+                </div>
+
+                <div class="ai-layout">
+                    <!-- 语义分析 -->
+                    <div class="form-section">
+                        <h2>🔍 语义分析</h2>
+                        <div class="form-row">
+                            <div class="form-group" style="flex:1;">
+                                <label for="analyzeText">输入文本</label>
+                                <textarea id="analyzeText" placeholder="输入需要分析的文本，例如：今天天气真好，心情非常愉快！" rows="3"></textarea>
+                            </div>
+                            <button class="btn" id="btnAnalyze" onclick="analyzeText()" style="align-self:flex-end;">分析</button>
+                        </div>
+
+                        <div class="analyze-result" id="analyzeResult">
+                            <h3>📊 分析结果</h3>
+                            <div class="analyze-grid">
+                                <div class="analyze-item">
+                                    <div class="label">情感</div>
+                                    <div class="value" id="resultSentiment">-</div>
+                                </div>
+                                <div class="analyze-item">
+                                    <div class="label">分类</div>
+                                    <div class="value" id="resultCategory">-</div>
+                                </div>
+                                <div class="analyze-item" style="grid-column: span 2;">
+                                    <div class="label">摘要</div>
+                                    <div class="value" id="resultSummary">-</div>
+                                </div>
+                                <div class="analyze-item" style="grid-column: span 2;">
+                                    <div class="label">关键词</div>
+                                    <div class="value" id="resultKeywords">-</div>
+                                </div>
+                            </div>
+                        </div>
+                    </div>
+
+                    <!-- 流式对话 -->
+                    <div class="form-section" style="margin-bottom: 0;">
+                        <h2>💬 AI 对话（流式输出）</h2>
+                        <div class="chat-container">
+                            <div class="chat-messages" id="chatMessages">
+                                <div class="empty-chat">💡 输入消息后按发送，AI 将实时流式回复</div>
+                            </div>
+                            <div class="chat-input-area">
+                                <textarea id="chatInput" rows="1"
+                                    placeholder="输入消息..."
+                                    onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendChat();}"></textarea>
+                                <button class="btn" id="btnSend" onclick="sendChat()">发送</button>
+                            </div>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </div>
+    </div>
+
+    <script>
+        const API_BASE = 'http://localhost:8080';
+
+        // ============================================================
+        //  Tab 切换
+        // ============================================================
+        function switchTab(tab) {
+            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
+            document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));
+            document.querySelector(`.tab-btn[onclick*="${tab}"]`).classList.add('active');
+            document.getElementById('tab-' + tab).classList.add('active');
+            if (tab === 'ai') checkApiHealth();
+        }
+
+        // ============================================================
+        //  用户管理
+        // ============================================================
+        async function loadUsers() {
+            const loading = document.getElementById('loading');
+            const tableWrapper = document.getElementById('tableWrapper');
+            const tbody = document.getElementById('userTableBody');
+            const btnRefresh = document.getElementById('btnRefresh');
+
+            loading.style.display = 'block';
+            tableWrapper.style.display = 'none';
+            btnRefresh.disabled = true;
+
+            try {
+                const res = await fetch(API_BASE + '/user');
+                if (!res.ok) throw new Error('HTTP ' + res.status);
+                const users = await res.json();
+
+                loading.style.display = 'none';
+                tableWrapper.style.display = 'block';
+
+                if (users.length === 0) {
+                    tbody.innerHTML = '<tr class="empty-row"><td colspan="4">暂无用户数据</td></tr>';
+                } else {
+                    tbody.innerHTML = users.map(user => `
+                        <tr>
+                            <td><span class="badge">${user.id}</span></td>
+                            <td>${escapeHtml(user.name)}</td>
+                            <td>${user.age}</td>
+                            <td>${escapeHtml(user.email || '-')}</td>
+                        </tr>
+                    `).join('');
+                }
+            } catch (err) {
+                loading.style.display = 'none';
+                showMessage('加载用户列表失败：' + err.message, 'error');
+            } finally {
+                btnRefresh.disabled = false;
+            }
+        }
+
+        async function addUser() {
+            const name = document.getElementById('name').value.trim();
+            const age = document.getElementById('age').value.trim();
+            const email = document.getElementById('email').value.trim();
+            const btn = document.getElementById('btnSubmit');
+
+            if (!name) { showMessage('请输入姓名', 'error'); return; }
+            if (!age || isNaN(age) || parseInt(age) <= 0) { showMessage('请输入有效的年龄', 'error'); return; }
+
+            btn.disabled = true;
+
+            try {
+                const res = await fetch(API_BASE + '/user', {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({ name, age: parseInt(age), email: email || undefined })
+                });
+
+                if (!res.ok) throw new Error('HTTP ' + res.status);
+                const data = await res.json();
+
+                if (data.success) {
+                    showMessage('🎉 用户「' + name + '」创建成功！', 'success');
+                    document.getElementById('name').value = '';
+                    document.getElementById('age').value = '';
+                    document.getElementById('email').value = '';
+                    loadUsers();
+                } else {
+                    showMessage('创建失败', 'error');
+                }
+            } catch (err) {
+                showMessage('添加用户失败：' + err.message, 'error');
+            } finally {
+                btn.disabled = false;
+            }
+        }
+
+        function showMessage(text, type) {
+            const msg = document.getElementById('message');
+            msg.textContent = text;
+            msg.className = 'message ' + type;
+            if (type === 'success') {
+                setTimeout(() => { msg.style.display = 'none'; }, 3000);
+            }
+        }
+
+        function escapeHtml(str) {
+            const div = document.createElement('div');
+            div.textContent = str;
+            return div.innerHTML;
+        }
+
+        // ============================================================
+        //  DeepSeek AI - 健康检查
+        // ============================================================
+        async function checkApiHealth() {
+            try {
+                const res = await fetch(API_BASE + '/api/chat/health');
+                const data = await res.json();
+                const warning = document.getElementById('apiKeyWarning');
+                if (data.apiKeyConfigured) {
+                    warning.classList.remove('show');
+                } else {
+                    warning.classList.add('show');
+                }
+            } catch (e) {
+                // 忽略
+            }
+        }
+
+        // ============================================================
+        //  DeepSeek AI - 语义分析
+        // ============================================================
+        async function analyzeText() {
+            const text = document.getElementById('analyzeText').value.trim();
+            const btn = document.getElementById('btnAnalyze');
+            const resultDiv = document.getElementById('analyzeResult');
+
+            if (!text) { alert('请输入需要分析的文本'); return; }
+
+            btn.disabled = true;
+            btn.textContent = '分析中...';
+            resultDiv.classList.remove('show');
+
+            try {
+                const res = await fetch(API_BASE + '/api/chat/analyze', {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({ text })
+                });
+
+                if (!res.ok) throw new Error('HTTP ' + res.status);
+                const data = await res.json();
+
+                if (data.success) {
+                    // 尝试解析返回的 JSON
+                    let analysis;
+                    try {
+                        analysis = JSON.parse(data.data);
+                    } catch (e) {
+                        analysis = { raw: data.data };
+                    }
+
+                    // 渲染结果
+                    const sentiment = analysis.sentiment || '-';
+                    const sentimentClass = 'sentiment-' + sentiment;
+                    document.getElementById('resultSentiment').innerHTML =
+                        `<span class="${sentimentClass}">${sentiment}</span>`;
+
+                    document.getElementById('resultCategory').textContent = analysis.category || '-';
+
+                    document.getElementById('resultSummary').textContent = analysis.summary || '-';
+
+                    const keywords = analysis.keywords;
+                    if (Array.isArray(keywords) && keywords.length > 0) {
+                        document.getElementById('resultKeywords').innerHTML =
+                            keywords.map(k => `<span class="tag">${escapeHtml(k)}</span>`).join('');
+                    } else if (typeof keywords === 'string') {
+                        document.getElementById('resultKeywords').textContent = keywords;
+                    } else {
+                        document.getElementById('resultKeywords').textContent = '-';
+                    }
+
+                    resultDiv.classList.add('show');
+                } else {
+                    alert('分析失败：' + (data.error || '未知错误'));
+                }
+            } catch (err) {
+                alert('语义分析请求失败：' + err.message);
+            } finally {
+                btn.disabled = false;
+                btn.textContent = '分析';
+            }
+        }
+
+        // ============================================================
+        //  DeepSeek AI - 流式对话 (SSE)
+        // ============================================================
+        let abortController = null;
+
+        async function sendChat() {
+            const input = document.getElementById('chatInput');
+            const message = input.value.trim();
+            const btn = document.getElementById('btnSend');
+            const messagesDiv = document.getElementById('chatMessages');
+
+            if (!message) return;
+
+            // 清除空状态
+            const empty = messagesDiv.querySelector('.empty-chat');
+            if (empty) empty.remove();
+
+            // 添加用户消息
+            addChatMessage('user', message);
+            input.value = '';
+            btn.disabled = true;
+
+            // 添加 AI 消息占位
+            const aiMsgDiv = document.createElement('div');
+            aiMsgDiv.className = 'chat-msg assistant';
+            const bubble = document.createElement('div');
+            bubble.className = 'bubble';
+            bubble.innerHTML = '<span class="cursor-blink"></span>';
+            aiMsgDiv.appendChild(bubble);
+            const meta = document.createElement('div');
+            meta.className = 'meta';
+            aiMsgDiv.appendChild(meta);
+            messagesDiv.appendChild(aiMsgDiv);
+            messagesDiv.scrollTop = messagesDiv.scrollHeight;
+
+            try {
+                abortController = new AbortController();
+
+                const res = await fetch(API_BASE + '/api/chat/stream', {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({
+                        message: message,
+                        systemPrompt: '你是一个智能AI助手，请用中文回答用户问题。回答要简洁、准确、有帮助。'
+                    }),
+                    signal: abortController.signal
+                });
+
+                if (!res.ok) throw new Error('HTTP ' + res.status);
+
+                const reader = res.body.getReader();
+                const decoder = new TextDecoder();
+                let buffer = '';
+                let fullContent = '';
+                let currentEvent = '';
+
+                while (true) {
+                    const { done, value } = await reader.read();
+                    if (done) break;
+
+                    buffer += decoder.decode(value, { stream: true });
+
+                    // 解析 SSE 事件（格式：event: xxx\ndata: xxx\n\n）
+                    const parts = buffer.split('\n');
+                    // 保留最后一个可能不完整的部分
+                    buffer = parts.pop() || '';
+
+                    for (const line of parts) {
+                        const trimmed = line.trim();
+
+                        if (trimmed.startsWith('event:')) {
+                            currentEvent = trimmed.substring(6).trim();
+                        } else if (trimmed.startsWith('data:')) {
+                            const data = trimmed.substring(5).trim();
+                            if (data === '' || data === '[DONE]') {
+                                if (currentEvent === 'done') {
+                                    // 对话完成
+                                }
+                                currentEvent = '';
+                                continue;
+                            }
+
+                            if (currentEvent === 'message') {
+                                // 后端直接发送文本块，无需 JSON 解析
+                                fullContent += data;
+                                bubble.textContent = fullContent;
+                                messagesDiv.scrollTop = messagesDiv.scrollHeight;
+                            } else if (currentEvent === 'error') {
+                                fullContent += '[错误: ' + data + ']';
+                                bubble.textContent = fullContent;
+                            }
+                            currentEvent = '';
+                        }
+                    }
+                }
+
+                // 最终显示
+                bubble.textContent = fullContent || '(未获取到回复)';
+                meta.textContent = '完成';
+
+            } catch (err) {
+                if (err.name === 'AbortError') {
+                    bubble.textContent = '✋ 已取消';
+                } else {
+                    bubble.innerHTML = `❌ 请求失败：${escapeHtml(err.message)}`;
+                }
+                meta.textContent = '错误';
+            } finally {
+                btn.disabled = false;
+                abortController = null;
+                messagesDiv.scrollTop = messagesDiv.scrollHeight;
+            }
+        }
+
+        function addChatMessage(role, content) {
+            const messagesDiv = document.getElementById('chatMessages');
+            const div = document.createElement('div');
+            div.className = 'chat-msg ' + role;
+            div.innerHTML = `
+                <div class="bubble">${escapeHtml(content)}</div>
+                <div class="meta">${role === 'user' ? '你' : 'AI'} · ${new Date().toLocaleTimeString()}</div>
+            `;
+            messagesDiv.appendChild(div);
+            messagesDiv.scrollTop = messagesDiv.scrollHeight;
+        }
+
+        // ============================================================
+        //  页面加载
+        // ============================================================
+        window.addEventListener('DOMContentLoaded', () => {
+            loadUsers();
+            checkApiHealth();
+        });
+    </script>
+</body>
+</html>
